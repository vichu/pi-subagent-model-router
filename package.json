{
  "name": "pi-subagent-model-router",
  "version": "0.5.1",
  "repository": "git+https://github.com/vichu/pi-subagent-model-router.git",
  "description": "Config-driven model routing for Pi subagents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "subagents"
  ],
  "files": [
    "src",
    "router.json",
    "agents/router-spike-worker.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi-subagents": {
    "agents": ["./agents"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "~5.9.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "pi-subagents": ">=0.89.1"
  }
}
